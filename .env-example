# ═══════════════════════════════════════════════════════════════
# Configuration — adjust values before first start
# ═══════════════════════════════════════════════════════════════

# ── Host data location ───────────────────────────────────────────
# Base directory on the host for all bind-mounted runtime data and
# config (certs/, sftp-home/, cert-targets.yml, sftp-users.conf).
# Create the layout once with: ./scripts/host/bootstrap.sh
DATA_ROOT=/opt/certificate-resolver

# Single host folder for ALL log files (UI + resolver). Mounted into both
# containers at /logs. Docker creates it automatically if missing.
LOG_ROOT=/var/log/certificate_resolver

# ── acme-dns ─────────────────────────────────────────────────────
# Subdomain under which acme-dns runs (A record must point to SERVER_IP)
ACMEDNS_ZONE=acmedns.auth.example.com
# Public IP address of this server
SERVER_IP=1.2.3.4

# ── Certificate check time ───────────────────────────────────────
# Local time of day the daily renewal check runs (default: 03:00),
# interpreted in TZ below.
RENEW_HOUR=3
RENEW_MINUTE=0
# 1 = skip the renewal check on Saturday/Sunday (default), 0 = run daily.
# Safe: acme.sh renews ~30 days before expiry, so skipped days don't matter.
SKIP_WEEKENDS=1
# Time zone of the container (renewal time, weekend check, log timestamps)
TZ=Europe/Berlin

# ── Email notifications ───────────────────────────────────────────
# Leave empty to disable notifications.
# Example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#          SMTP_USER=sender@example.com  SMTP_PASSWORD=app-password
#          SMTP_FROM=certificate-resolver@example.com
#          NOTIFY_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# ── acme.sh runtime data ─────────────────────────────────────────
# Persistent directory for acme.sh (account.conf, domain configs).
# Binary is baked into the image (/opt/acme.sh); data persists here across restarts.
ACME_DATA=/data/acme

# ── Logging ──────────────────────────────────────────────────────
# Minimum level for stdout: debug|info|notice|warning|err|crit|alert|emerg
# NOTE: Use CR_LOG_LEVEL — LOG_LEVEL is used internally by acme.sh
CR_LOG_LEVEL=info
# Persistent log file (self-rotating; detailed program logs additionally go to
# /data/acme-dns.log and /data/renewal.log, rotated by supervisord).
CR_LOG_FILE=/logs/certificate-resolver.log
# Rotation of CR_LOG_FILE:
CR_LOG_MAX_BYTES=5242880   # rotate at 5 MB
CR_LOG_BACKUPS=5           # keep 5 rotated files

# ── Image version ────────────────────────────────────────────────
# Default "1" = newest 1.x release: fixes and features are picked up (e.g. by
# Watchtower), breaking 2.0 changes are not. Pin an exact release with e.g.
# RESOLVER_TAG=1.2.3, or use "edge" for the untested main branch.
# RESOLVER_TAG=1
