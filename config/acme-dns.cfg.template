[general]
# Values are populated automatically from .env on container start.
# Placeholders: ${ACMEDNS_ZONE} and ${SERVER_IP}
listen = "0.0.0.0:53"
protocol = "both"

domain  = "${ACMEDNS_ZONE}"
nsname  = "${ACMEDNS_ZONE}"
nsadmin = "hostmaster.${ACMEDNS_ZONE}"

records = [
    "${ACMEDNS_ZONE}. A    ${SERVER_IP}",
    "${ACMEDNS_ZONE}. NS   ${ACMEDNS_ZONE}.",
]

debug = false

[database]
engine = "sqlite3"
connection = "/data/acme-dns.db"

[api]
ip = "0.0.0.0"
port = "8080"
tls = "none"
corsorigins = ["*"]
use_header = false
header_name = "X-Forwarded-For"
disable_registration = false

[logconfig]
loglevel = "info"
logtype = "stdout"
logformat = "text"
